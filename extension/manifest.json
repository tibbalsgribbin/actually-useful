{
  "manifest_version": 3,
  "name": "Actually Useful",
  "version": "0.6.2",
  "description": "Shop on your terms instead of Amazon's.",
  "author": "Melissa (ko-fi.com/butactuallyuseful)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Actually Useful",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.com/s*"],
      "js": [
        "content/shared/core.js",
        "content/search.js"
      ],
      "css": ["content/shared/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://actuallyuseful.net/welcome*"],
      "js": ["content/welcome-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://actuallyuseful.net/compare.html*"],
      "js": ["content/page/compare-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/brand_blocklist.txt", "data/amazon_brands.txt"],
      "matches": ["https://www.amazon.com/*"]
    }
  ],
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://script.google.com/*",
    "https://actuallyuseful.net/*"
  ]
}
