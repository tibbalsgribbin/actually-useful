{
  "manifest_version": 3,
  "name": "Actually Useful",
  "version": "0.6.1",
  "description": "Shop on your terms instead of Amazon's.",
  "author": "Melissa (ko-fi.com/butactuallyuseful)",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Actually Useful"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.amazon.com/s*"],
      "js": [
        "content/shared/core.js",
        "content/search.js"
      ],
      "css": ["content/shared/styles.css"],
      "run_at": "document_idle"
    }
  ],

  "_content_scripts_product_disabled": [
    {
      "matches": ["https://www.amazon.com/dp/*"],
      "js": [
        "content/shared/core.js",
        "content/product.js"
      ],
      "css": ["content/shared/styles.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.amazon.com/*",
    "https://script.google.com/*"
  ]
}
