{
  "manifest_version": 3,
  "name": "Actually Useful",
  "version": "0.6.1",
  "description": "Shop on your terms instead of Amazon's.",
  "author": "Melissa (ko-fi.com/butactuallyuseful)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Actually Useful"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.com/s*"],
"js": [
  "content/shared/core.js",
  "content/search.js"
],
      "css": ["content/shared/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/brand_blocklist.txt", "data/amazon_brands.txt"],
      "matches": ["https://www.amazon.com/*"]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://script.google.com/*",
    "https://actuallyuseful.net/*"
  ]
}